# WordPress site URL — no trailing slash
WORDPRESS_URL=https://your-wordpress-site.com

# WooCommerce REST API Credentials
# Generate from: WooCommerce → Settings → Advanced → REST API
# Set permissions to: Read/Write
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session secret — 64+ char random hex string (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here

# Admin login password
ADMIN_PASSWORD=your_admin_password_here
